{
  "database": {
    "rules": "database.rules.json"
  },
  "hosting": {
    "source": ".",
    "site": "omct",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "frameworksBackend": {
      "region": "asia-east1"
    },
    "headers": [
      {
        "source": "/_next/static/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/fonts/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=2592000"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/locales/en/translation.json",
        "destination": "/locales/en/common.json",
        "type": 301
      },
      {
        "source": "/locales/ko/translation.json",
        "destination": "/locales/ko/common.json",
        "type": 301
      }
    ]
  }
}
