{
  "compilerOptions": {
    "module": "esnext",
    "target": "es6",
    "paths": {
      "@Components/*": ["./src/components/*"],
      "@Constant/*": ["./src/constant/*"],
      "@Data/*": ["./src/data/*"],
      "@Hooks/*": ["./src/hooks/*"],
      "@Libs/*": ["./src/libs/*"],
      "@Pages/*": ["./src/pages/*"],
      "@Recoil/*": ["./src/recoil/*"],
      "@Styles/*": ["./src/styles/*"],
      "@Utils/*": ["./src/utils/*"],
      "@Base/*": ["./base/*"],
      "@Root/*": ["./*"],
      "public/*": ["./public/*"]
    },
    "allowJs": true,
    "jsx": "preserve",
    "alwaysStrict": true,
    "strict": true,
    "noImplicitAny": true,
    "allowSyntheticDefaultImports": true,
    "lib": ["dom", "dom.iterable", "esnext"],
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "incremental": true,
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "strictPropertyInitialization": false
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "@types/**/*d.ts",
    ".next/types/**/*.ts",
    "base/**/*.ts",
    "base/**/*.tsx",
    "middleware.ts"
  ],
  "exclude": ["node_modules", "src/libs"]
}
